APP_NAME="Gotham Express"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (MySQL for prod; sqlite is fine for Day-1 local) ---
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gothamexpress
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sessions / queue / cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Day 1 keeps sync; Day 6 flips to database and starts a worker
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail (SMTP, SMTPS on port 465) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.spacemail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Gotham Express"
# Where internal / admin notifications are delivered (contact-form copies, etc.)
MAIL_ADMIN_TO=

# --- Gotham Express project constants (consumed by config/gotham.php) ---
GOTHAM_INVITE_CODE_EXPIRY_HOURS=6
GOTHAM_VERIFICATION_CODE_EXPIRY_MINUTES=60
GOTHAM_PASSWORD_RESET_CODE_EXPIRY_MINUTES=15
GOTHAM_PASSWORD_RESET_MAX_ATTEMPTS=5
GOTHAM_TRACKING_ID_PREFIX=GTX-
GOTHAM_TELEGRAM_BOT_HANDLE="@GothamExpressBot"

# --- First super admin (consumed by SuperAdminSeeder; required for seed) ---
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL=admin@gotham.local
SEED_ADMIN_PASSWORD=changeme-at-first-login

# --- Day-6 integrations (not needed to boot Day 1) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PUBLIC_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
